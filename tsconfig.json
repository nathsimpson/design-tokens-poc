{
	"compilerOptions": {
		"target": "esnext",
		"module": "esnext",
		"lib": ["dom", "dom.iterable", "esnext"],
		"moduleResolution": "node",
		"strict": true,
		"noEmit": true,
		"jsx": "react-jsx",
		"esModuleInterop": true,
		"forceConsistentCasingInFileNames": true,
		"allowJs": true,
		"skipLibCheck": true,
		"isolatedModules": true,
		"incremental": true
	},
	"exclude": ["node_modules", "build"]
}
