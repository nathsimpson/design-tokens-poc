{
	"name": "gel-design-tokens",
	"private": true,
	"version": "1.0.0",
	"description": "A POC Design Tokens library inspired by a group of Australian banks",
	"scripts": {
		"build": "yarn clean && yarn build:tokens && yarn build:viewer",
		"build:tokens": "tsx build.ts",
		"build:viewer": "yarn workspace token-viewer build",
		"dev": "yarn workspace token-viewer dev",
		"check:format": "yarn prettier . --cache --check",
		"check:types": "tsc --noEmit",
		"check": "yarn check:format && yarn check:types",
		"clean": "rm -rf build",
		"test": "echo \"Error: no test specified\" && exit 1"
	},
	"author": "Nathan Simpson",
	"license": "ISC",
	"dependencies": {
		"style-dictionary": "^4.1.2",
		"typescript": "^5.6.2"
	},
	"devDependencies": {
		"@eslint/js": "^9.10.0",
		"@types/eslint__js": "^8.42.3",
		"eslint": "^9.10.0",
		"prettier": "^2.8.8",
		"tsx": "^4.17.0",
		"typescript-eslint": "^8.6.0"
	},
	"workspaces": [
		"token-viewer"
	]
}
